# ─── Database ───
DATABASE_URL=postgresql+asyncpg://tablz_app:dev-password-changeme@localhost:5432/tablz
DATABASE_URL_SYNC=postgresql://tablz_app:dev-password-changeme@localhost:5432/tablz

# ─── Security ───
JWT_SECRET_KEY=change-me-to-a-256-bit-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── AWS ───
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
AWS_REGION=ap-south-1
S3_BUCKET_NAME=tablz-uploads-dev

# ─── Email ───
SENDGRID_API_KEY=your-sendgrid-key
FROM_EMAIL=noreply@tablz.app

# ─── App ───
BASE_URL=http://localhost:3000
ENVIRONMENT=development
